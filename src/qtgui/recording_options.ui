           </widget>
          </item>
          <item row="0" column="1">
           <widget class="QSpinBox" name="preBufferSpin">
            <property name="minimum">
             <number>0</number>
            </property>
            <property name="maximum">
             <number>5000</number>
            </property>
            <property name="value">
             <number>500</number>
            </property>
            <property name="toolTip">
             <string>Audio captured before squelch opens</string>
            </property>
           </widget>
          </item>
          <item row="1" column="0">
           <widget class="QLabel" name="labelPostBuffer">
            <property name="text">
             <string>Post-buffer (ms):</string>
            </property>
           </widget>
          </item>
          <item row="1" column="1">
           <widget class="QSpinBox" name="postBufferSpin">
            <property name="minimum">
             <number>0</number>
            </property>
            <property name="maximum">
             <number>10000</number>
            </property>
            <property name="value">
             <number>1000</number>
            </property>
            <property name="toolTip">
             <string>Continue recording after squelch closes</string>
